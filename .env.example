# ---------------------------------------------------------------------------
# Telugu Riddle -- environment configuration
#
# Copy to .env and fill in the password:   cp .env.example .env
# .env is gitignored. Never commit a real password.
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================

# --- DATABASE_URL ----------------------------------------------------------
# Supabase project: rvebezvialcfbmqkblol
#
# Use the TRANSACTION POOLER (port 6543), not the direct connection (5432).
# Vercel opens a new connection per function invocation; the direct port runs
# out of Postgres slots as soon as traffic scales. The pooler is built for it.
#
# Find it: Supabase -> Connect -> Connection string -> Transaction pooler
# Replace <REGION> and <PASSWORD> with your values.
DATABASE_URL=postgresql://postgres.rvebezvialcfbmqkblol:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# Direct connection (port 5432) -- fine for LOCAL work and one-off imports,
# NOT for the deployed Vercel function:
# DATABASE_URL=postgresql://postgres:<PASSWORD>@db.rvebezvialcfbmqkblol.supabase.co:5432/postgres

# Local development with no external database at all:
# DATABASE_URL=sqlite+pysqlite:///./tollyriddl.db

# --- DAILY_SEED ------------------------------------------------------------
# Seeds the deterministic daily puzzle. Changing it reshuffles the ENTIRE
# schedule including past dates, so set it once and leave it alone.
DAILY_SEED=telugu-mystery

# --- ARCHIVE_START_DATE ----------------------------------------------------
# Earliest playable date. Dates before this return "not available".
ARCHIVE_START_DATE=2026-01-01


# === OPTIONAL (sensible defaults already applied) ==========================

# Frontend: leave EMPTY for same-origin (Vercel, and Vite's dev proxy).
# Set only if the API is hosted on a different domain.
VITE_API_URL=

# Dev only: where `npm run dev` proxies /api requests.
VITE_API_PROXY=http://127.0.0.1:8000

# Gameplay rules
BASE_ATTEMPTS=7
BONUS_ATTEMPTS=3
LIFELINE_1_AFTER=4
LIFELINE_2_AFTER=6

# Daily-puzzle eligibility thresholds
MIN_QUALITY_SCORE=6
MIN_CAST=2
MIN_GENRES=1
ARCHIVE_MAX_DAYS=30

# Same-origin deploys need no CORS entry. Comma-separated list otherwise.
CORS_ORIGINS=*
DEBUG=false
SEARCH_LIMIT=12


# === NOT NEEDED ============================================================
# This app talks to Postgres directly via SQLAlchemy, so the Supabase
# anon key, service_role key, and SUPABASE_URL are NOT required.
# Keeping the service_role key out of the deployment is deliberate: it
# bypasses row-level security and has no business in this app.
